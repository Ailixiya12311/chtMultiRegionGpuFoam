/* libgpucht.so and the solver go to OpenFOAM's user directories unless GPUCHT_LIBBIN / GPUCHT_APPBIN say
   otherwise (Allwmake; tools/build_app.sh puts both in build/<backend> for the verification scripts) */
GPUCHT_LIBBIN ?= $(FOAM_USER_LIBBIN)
GPUCHT_APPBIN ?= $(FOAM_USER_APPBIN)

EXE_INC = \
    -I../../lib \
    -I$(LIB_SRC)/finiteVolume/lnInclude \
    -I$(LIB_SRC)/meshTools/lnInclude \
    -I$(LIB_SRC)/regionModels/regionModel/lnInclude

EXE_LIBS = \
    -lfiniteVolume \
    -lfvOptions \
    -lmeshTools \
    -lsampling \
    -lcompressibleTransportModels \
    -lfluidThermophysicalModels \
    -lspecie \
    -lreactionThermophysicalModels \
    -lsolidThermo \
    -lturbulenceModels \
    -lcompressibleTurbulenceModels \
    -lthermoTools \
    -lradiationModels \
    -lregionModels \
    -ldl \
    -L$(GPUCHT_LIBBIN) -lgpucht -Wl,-rpath,'$$ORIGIN' -Wl,-rpath,$(GPUCHT_LIBBIN)
