/* GCOF: project root (gpu_cht_of_r1), GCOF_BIN: build/omp or build/cuda (libgpucht.so and the executable) */
EXE_INC = \
    -I$(GCOF)/lib \
    -I$(LIB_SRC)/finiteVolume/lnInclude \
    -I$(LIB_SRC)/meshTools/lnInclude \
    -I$(LIB_SRC)/regionModels/regionModel/lnInclude

EXE_LIBS = \
    -lfiniteVolume \
    -lfvOptions \
    -lmeshTools \
    -lsampling \
    -lcompressibleTransportModels \
    -lfluidThermophysicalModels \
    -lspecie \
    -lreactionThermophysicalModels \
    -lsolidThermo \
    -lturbulenceModels \
    -lcompressibleTurbulenceModels \
    -lthermoTools \
    -lradiationModels \
    -lregionModels \
    -ldl \
    -L$(GCOF_BIN) -lgpucht -Wl,-rpath,'$$ORIGIN' -Wl,-rpath,$(GCOF_BIN)
